+        end
+        self:addBreakdown(breakdownId, { stage = 1, isActive = true, isVisible = true })
+        if applyRtwFlat ~= nil and self:hasBreakdown(breakdownId) then
+            applyRtwFlat()
+        end
+    end
+end
