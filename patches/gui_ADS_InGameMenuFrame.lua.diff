+function ADS_InGameMenuFrame:onClickPartsSection()
+    if self.subCategoryPaging ~= nil then
+        self.subCategoryPaging:setState(ADS_InGameMenuFrame.SUB_CATEGORY.PARTS, true)
+    end
+
+    self:updateSubCategoryPages(ADS_InGameMenuFrame.SUB_CATEGORY.PARTS)
+end
+
+-- ==========================================================
+--   Parts tab (data comes from the Parts Cabinet mod, FS25_Parts_Cabinet)
+-- ==========================================================
+local function setPartsCellText(cell, name, text, r, g, b, a)
+    local element = cell:getAttribute(name)
+    if element ~= nil then
+        element:setText(text or "")
+        element:setTextColor(r or 1, g or 1, b or 1, a or 1)
+    end
+end
+
+function ADS_InGameMenuFrame:reloadPartsRows()
+    local ADSParts = getPartsMod()
+    local available = ADSParts ~= nil and ADSParts.getMenuStockRows ~= nil
+    local farmId = g_currentMission ~= nil and g_currentMission:getFarmId() or FarmManager.SPECTATOR_FARM_ID
+
+    self.partsStockRows = {}
+    self.partsDeliveryRows = {}
+    if available then
+        self.partsStockRows = ADSParts.getMenuStockRows(farmId) or {}
+        self.partsDeliveryRows = ADSParts.getMenuDeliveryRows(farmId) or {}
+    end
+
+    local hasDeliveries = #self.partsDeliveryRows > 0
+    local visibleElements = {
+        { self.partsStockHeader, available },
+        { self.partsStockList, available },
+        { self.partsDeliveryHeader, available and hasDeliveries },
+        { self.partsDeliveryList, available and hasDeliveries },
+        { self.partsDeliverySliderBox, available and hasDeliveries },
+        { self.partsDeliveryEmptyText, available and not hasDeliveries },
+        { self.partsUnavailableText, not available },
+    }
+    for _, entry in ipairs(visibleElements) do
+        if entry[1] ~= nil then
+            entry[1]:setVisible(entry[2])
+        end
+    end
+
+    if self.partsStockList ~= nil then
+        self.partsStockList:reloadData()
+    end
+    if self.partsDeliveryList ~= nil then
+        self.partsDeliveryList:reloadData()
+    end
+    self:updateBalanceDisplay()
+end
+
+function ADS_InGameMenuFrame:populatePartsCell(list, index, cell)
+    if list == self.partsStockList then
+        local row = self.partsStockRows[index]
+        if row == nil then return end
+        setPartsCellText(cell, "partsCategoryText", row.label)
+        setPartsCellText(cell, "partsOemText", row.OEM)
+        setPartsCellText(cell, "partsAftermarketText", row.AFTERMARKET)
+        setPartsCellText(cell, "partsPremiumText", row.PREMIUM)
+        if row.total > 0 then
+            setPartsCellText(cell, "partsTotalText", row.totalText, 0.659, 0.847, 0.286, 1)
+        else
+            setPartsCellText(cell, "partsTotalText", row.totalText)
+        end
+        return
+    end
+
+    local row = self.partsDeliveryRows[index]
+    if row == nil then return end
+    setPartsCellText(cell, "partsItemText", row.item)
+    setPartsCellText(cell, "partsQualityText", row.quality)
+    setPartsCellText(cell, "partsValueText", row.value)
+    if row.isWaiting then
+        -- delivered pallets that still need to be put away
+        setPartsCellText(cell, "partsStatusText", row.status, 1, 0.55, 0.05, 1)
+    else
+        setPartsCellText(cell, "partsStatusText", row.status)
+    end
+    setPartsCellText(cell, "partsWhereText", row.location)
+end
+
+function ADS_InGameMenuFrame:onOrderParts()
+    local _, ADSPartsDialog = getPartsMod()
+    if ADSPartsDialog == nil or g_currentMission == nil then
+        return
+    end
+    local farmId = g_currentMission:getFarmId()
+    if farmId == nil or farmId == FarmManager.SPECTATOR_FARM_ID then
+        return
+    end
+    ADSPartsDialog.show(farmId, nil)
+end
+
+-- called by the Parts Cabinet mod whenever stock, orders or pallets change
+function ADS_InGameMenuFrame.onPartsDataChanged()
+    local frame = ADS_InGameMenuFrame.INSTANCE
+    if frame ~= nil and frame.subCategoryPages ~= nil
+            and frame:getCurrentSubCategory() == ADS_InGameMenuFrame.SUB_CATEGORY.PARTS then
+        frame:reloadPartsRows()
+    end
+end
+
 function ADS_InGameMenuFrame:onClickSettingsSection()
     if self.subCategoryPaging ~= nil then
         self.subCategoryPaging:setState(ADS_InGameMenuFrame.SUB_CATEGORY.SETTINGS, true)
