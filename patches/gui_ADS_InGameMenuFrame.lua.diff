 local ADS_InGameMenuFrame_mt = Class(ADS_InGameMenuFrame, TabbedMenuFrameElement)
 
+-- Each FS25 mod has its own environment, so the Parts Cabinet mod's tables are
+-- looked up in its mod environment (FS25_Parts_Cabinet), not by global name.
+ADS_InGameMenuFrame.PARTS_MOD_NAME = "FS25_Parts_Cabinet"
+
+local function getPartsMod()
+    local cached = ADS_InGameMenuFrame.partsModEnv
+    if cached ~= nil and cached.ADSParts ~= nil then
+        return cached.ADSParts, cached.ADSPartsDialog
+    end
+
+    local mt = getmetatable(_G)
+    local globals = (mt ~= nil and type(mt.__index) == "table") and mt.__index or _G
+    local env = globals[ADS_InGameMenuFrame.PARTS_MOD_NAME]
+    if type(env) ~= "table" or rawget(env, "ADSParts") == nil then
+        env = nil
+        -- zip renamed: find the mod environment that holds ADSParts
+        for _, value in pairs(globals) do
+            if type(value) == "table" and value ~= _G and rawget(value, "ADSParts") ~= nil and rawget(value, "ADSPartsDialog") ~= nil then
+                env = value
+                break
+            end
+        end
+    end
+    if env == nil and rawget(globals, "ADSParts") ~= nil then
+        env = globals
+    end
+
+    if env ~= nil then
+        ADS_InGameMenuFrame.partsModEnv = env
+        return env.ADSParts, env.ADSPartsDialog
+    end
+    return nil, nil
+end
+
