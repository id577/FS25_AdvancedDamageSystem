+-- Side column layout (lights down the left side of the speedometer).
+-- All numbers are HUD pixels relative to the speedometer gauge centre (+y = up).
+ADS_Hud.SIDE_LAYOUT = {
+    columnX = -151,
+    iconSize = 17,
+    smallIconSize = 9,           -- the transmission light sits in the small "dot" slot
+    dividerWidth = 34,
+    textSize = 9,
+    smallTextSize = 7,
+    slots = {
+        brakes       = { iconY = 121 },
+        engine       = { iconY = 94,  textY = 80 },   -- engine load %
+        coolant      = { iconY = 53,  textY = 40 },   -- engine temperature
+        warning      = { iconY = 11 },
+        transmission = { iconY = -29 },
+        battery      = { iconY = -62, textY = -76 },  -- system voltage
+        oil          = { iconY = -102 },
+    },
+    dividers = { 108, 68, 29, -9, -45, -88 },
+    service = { hoursY = 67, lineY = 61, intervalY = 55, lineWidth = 22 },
+}
+
+function ADS_Hud:storeSideLayoutValues()
+    local L = ADS_Hud.SIDE_LAYOUT
+    local cfg = (ADS_Config ~= nil and ADS_Config.HUD) or {}
+    local baseX = L.columnX + (tonumber(cfg.SIDE_OFFSET_X) or 0)
+    local baseY = tonumber(cfg.SIDE_OFFSET_Y) or 0
+
+    local side = { slots = {}, dividers = {} }
+    side.columnX = self:scalePixelValuesToScreenVector(baseX, 0)
+
+    for id, slot in pairs(L.slots) do
+        local size = id == "transmission" and L.smallIconSize or L.iconSize
+        local w, h = self:scalePixelValuesToScreenVector(size, size)
+        local _, iconY = self:scalePixelValuesToScreenVector(0, slot.iconY + baseY)
+        local entry = { iconW = w, iconH = h, iconY = iconY }
+        if slot.textY ~= nil then
+            local _, textY = self:scalePixelValuesToScreenVector(0, slot.textY + baseY)
+            entry.textY = textY
+        end
+        side.slots[id] = entry
+    end
+
+    for i, y in ipairs(L.dividers) do
+        local _, dy = self:scalePixelValuesToScreenVector(0, y + baseY)
+        side.dividers[i] = dy
+    end
+    side.dividerWidth = self:scalePixelValuesToScreenVector(L.dividerWidth, 0)
+    side.dividerHeight = math.max(self:scalePixelToScreenHeight(1), 1 / 1080)
+    side.textSize = self:scalePixelToScreenHeight(L.textSize)
+    side.smallTextSize = self:scalePixelToScreenHeight(L.smallTextSize)
+
+    local _, hoursY = self:scalePixelValuesToScreenVector(0, L.service.hoursY)
+    local _, lineY = self:scalePixelValuesToScreenVector(0, L.service.lineY)
+    local _, intervalY = self:scalePixelValuesToScreenVector(0, L.service.intervalY)
+    side.serviceHoursY, side.serviceLineY, side.serviceIntervalY = hoursY, lineY, intervalY
+    side.serviceLineWidth = self:scalePixelValuesToScreenVector(L.service.lineWidth, 0)
+
+    self.sideLayout = side
+end
+
+function ADS_Hud:getIsSideLayout()
+    local cfg = ADS_Config ~= nil and ADS_Config.HUD or nil
+    return cfg == nil or cfg.DASHBOARD_LAYOUT ~= "classic"
 end
 
